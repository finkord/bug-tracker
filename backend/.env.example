# ========================================================
# Bug / Issue Tracking System — Environment Configuration
# ========================================================

# Server Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL 15)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bug_tracker

# Cache & Pub/Sub (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (JWT)
JWT_SECRET=super_secret_jwt_access_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Two-Factor Authentication (2FA / TOTP)
TWO_FACTOR_APP_NAME="BugTracker-PPofSE"

# Email Server (Mailpit Local SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="no-reply@bugtracker.local"
MAIL_SECURE=false

# Object Storage (SeaweedFS S3)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=any
S3_SECRET_ACCESS_KEY=any
S3_BUCKET_NAME=bugtracker-attachments
S3_FORCE_PATH_STYLE=true

# External Identity Providers (OAuth2 / OIDC)
GITHUB_CLIENT_ID=placeholder_github_client_id
GITHUB_CLIENT_SECRET=placeholder_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Bot Protection (Cloudflare Turnstile CAPTCHA)
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET=placeholder_turnstile_secret_key
CAPTCHA_SECRET_KEY=placeholder_turnstile_secret_key
