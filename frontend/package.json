{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "api:generate": "openapi-typescript ../swagger.json -o src/api/types/api.generated.ts",
    "api:sync": "curl -s http://localhost:3000/api/docs-json > ../swagger.json && npm run api:generate"
  },
  "dependencies": {
