# ==============================================================================
# BugTracker Production Environment Configuration Template (.env.production.example)
# ==============================================================================
# Copy this file to .env.production and set your infrastructure parameters.
#
# Standalone Cloud / AWS Deployment (Connects to RDS, ElastiCache, S3, SES):
#   docker compose --env-file .env.production up -d
#
# Full Local Preview (Using local docker-compose.infra.yml backing services):
#   make prod
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Exposure & Ingress
# ------------------------------------------------------------------------------
NODE_ENV=production
HTTP_PORT=80
PORT=3000
FRONTEND_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com
ENABLE_SWAGGER=false

# ------------------------------------------------------------------------------
# 2. Relational Database (PostgreSQL 15)
# Local Docker default: DB_HOST=postgres
# AWS RDS example:     DB_HOST=my-database.c12345678.us-east-1.rds.amazonaws.com
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=bug_tracker
DB_SYNCHRONIZE=false

# ------------------------------------------------------------------------------
# 3. Cache, Rate Limiting & WebSocket Bus (Redis 7)
# Local Docker default: REDIS_HOST=redis
# AWS ElastiCache:     REDIS_HOST=my-redis.xxxxxx.cache.amazonaws.com
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. S3-Compatible Object Storage
# Local SeaweedFS default: S3_ENDPOINT=http://seaweedfs:8333, S3_FORCE_PATH_STYLE=true
# Native AWS S3:          S3_ENDPOINT=https://s3.us-east-1.amazonaws.com, S3_FORCE_PATH_STYLE=false
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_with_s3_access_key
S3_SECRET_ACCESS_KEY=replace_with_s3_secret_key
S3_BUCKET_NAME=bugtracker-attachments
S3_FORCE_PATH_STYLE=true
SEAWEED_MASTER_URL=http://seaweedfs:9333
SEAWEED_VOLUME_URL=http://seaweedfs:8080

# ------------------------------------------------------------------------------
# 5. Transactional Mail Server (SMTP)
# Local Mailpit default:  MAIL_HOST=mailpit, MAIL_PORT=1025
# AWS SES SMTP default:   MAIL_HOST=email-smtp.us-east-1.amazonaws.com, MAIL_PORT=587
# ------------------------------------------------------------------------------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM="BugTracker <no-reply@bugtracker.local>"

# ------------------------------------------------------------------------------
# 6. Security, Authentication & Session Tokens (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_random_secret_minimum_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_random_secret_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# Initial Administrator Seed
INITIAL_ADMIN_EMAIL=admin@company.com
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
INITIAL_ADMIN_NAME="System Administrator"

# ------------------------------------------------------------------------------
# 7. External Identity Providers (OAuth2 / OIDC)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=placeholder_github_client_id
GITHUB_CLIENT_SECRET=placeholder_github_client_secret
GITHUB_CALLBACK_URL=https://your-domain.com/api/v1/auth/github/callback

GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 8. Bot Protection (Cloudflare Turnstile CAPTCHA)
# ------------------------------------------------------------------------------
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=placeholder_turnstile_secret_key
TURNSTILE_HOSTNAMES=your-domain.com
VITE_TURNSTILE_SITE_KEY=placeholder_turnstile_site_key
