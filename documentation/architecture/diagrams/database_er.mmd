    User {
        int id PK
        string email UK
        string fullName
        string systemRole
        boolean isTwoFactorEnabled
        boolean isActive
    }

    Project {
        int id PK
        string key UK
        string name
        int leadId FK
        int permissionSchemeId FK
        int issueSecuritySchemeId FK
    }

    Team {
        int id PK
        int projectId FK
        string name
        int sprintCapacityHours
    }

    TeamMember {
        int id PK
        int teamId FK
        int userId FK
        string role
    }

    Sprint {
        int id PK
        int projectId FK
        int teamId FK
        string name
        string status
        timestamp startDate
        timestamp endDate
    }

    Issue {
        int id PK
        string key UK
        int projectId FK
        int sprintId FK
        int epicId FK
        int parentId FK
        int fixVersionId FK
        int componentId FK
        int securityLevelId FK
        string title
        string issueType
        string status
        string priority
        int reporterId FK
        int assigneeId FK
        float estimatedHours
        float loggedHours
    }

    Worklog {
        int id PK
        int issueId FK
        int authorId FK
        float timeSpentHours
        timestamp startedAt
    }

    Comment {
        int id PK
        int issueId FK
        int authorId FK
        text body
    }

    Attachment {
        int id PK
        int issueId FK
        int uploaderId FK
        string filename
        string s3Key
        int sizeBytes
    }

    IssueLink {
        int id PK
        int sourceIssueId FK
        int targetIssueId FK
        string linkType
    }

    ProjectVersion {
        int id PK
        int projectId FK
        string name
        string status
        timestamp releaseDate
    }

    ProjectComponent {
        int id PK
        int projectId FK
        string name
        int leadId FK
    }

    Group {
        int id PK
        string name UK
        string description
    }

    UserGroup {
        int id PK
        int userId FK
        int groupId FK
    }

    PermissionScheme {
        int id PK
        string name UK
        string description
    }

    PermissionGrant {
        int id PK
        int schemeId FK
        string permission
        string grantType
        int roleId FK
        int groupId FK
    }

    ProjectRole {
        int id PK
        string name UK
        string description
    }

    ProjectRoleActor {
        int id PK
        int projectId FK
        int roleId FK
        int userId FK
        int groupId FK
    }

    IssueSecurityScheme {
        int id PK
        string name UK
        string description
        int defaultLevelId FK
    }

    IssueSecurityLevel {
        int id PK
        int schemeId FK
        string name
        string description
    }

    IssueSecurityGrant {
        int id PK
        int securityLevelId FK
        string grantType
        int roleId FK
        int groupId FK
    }

    LoginAuditLog {
        int id PK
        string email
        string ipAddress
        string status
        string failureReason
        timestamp createdAt
    }
