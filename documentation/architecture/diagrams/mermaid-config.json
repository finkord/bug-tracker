{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, 'Helvetica Neue', 'Liberation Sans', sans-serif",
    "fontSize": "13px",
    "darkMode": false,

    "primaryColor": "#FFFFFF",
    "primaryTextColor": "#0F172A",
    "primaryBorderColor": "#1E293B",

    "secondaryColor": "#F8FAFC",
    "secondaryTextColor": "#0F172A",
    "secondaryBorderColor": "#334155",

    "tertiaryColor": "#F1F5F9",
    "tertiaryTextColor": "#0F172A",
    "tertiaryBorderColor": "#475569",

    "mainBkg": "#FFFFFF",
    "nodeBorder": "#1E293B",
    "clusterBkg": "#FAFAFA",
    "clusterBorder": "#475569",
    "titleColor": "#0F172A",
    "edgeLabelBackground": "#FFFFFF",
    "lineColor": "#1E293B",

    "actorBkg": "#FFFFFF",
    "actorBorder": "#1E293B",
    "actorTextColor": "#0F172A",
    "actorLineColor": "#1E293B",
    "signalColor": "#1E293B",
    "signalTextColor": "#0F172A",
    "activationBorderColor": "#1E293B",
    "activationBkgColor": "#E2E8F0",
    "noteBkgColor": "#F8FAFC",
    "noteBorderColor": "#64748B",
    "noteTextColor": "#0F172A"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "linear",
    "padding": 16,
    "nodeSpacing": 45,
    "rankSpacing": 50
  },
  "sequence": {
    "diagramMarginX": 30,
    "diagramMarginY": 25,
    "actorMargin": 60,
    "width": 160,
    "height": 45,
    "boxMargin": 12,
    "boxTextMargin": 6,
    "noteMargin": 10,
    "messageMargin": 35,
    "mirrorActors": false
  },
  "er": {
    "diagramPadding": 25,
    "layoutDirection": "TB",
    "minEntityWidth": 140,
    "minEntityHeight": 55,
    "entityPadding": 15,
    "stroke": "#1E293B",
    "fill": "#FFFFFF",
    "fontSize": 12
  }
}
