# ==============================================================================
# Bug / Issue Tracking System — Local Development Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env in the repository root for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Client Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ENABLE_SWAGGER=true

# Frontend endpoints (Vite)
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000/events
VITE_DOCS_URL=http://localhost:3000/api/docs

# ------------------------------------------------------------------------------
# 2. Relational Database (PostgreSQL 15)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bug_tracker
DB_SYNCHRONIZE=true

# ------------------------------------------------------------------------------
# 3. In-Memory Cache & WebSocket Bus (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. S3-Compatible Object Storage (SeaweedFS S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=any
S3_SECRET_ACCESS_KEY=any
S3_BUCKET_NAME=bugtracker-attachments
S3_FORCE_PATH_STYLE=true
SEAWEED_MASTER_URL=http://localhost:9333
SEAWEED_VOLUME_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. Transactional Mail Server (Mailpit Local SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM="BugTracker <no-reply@bugtracker.local>"

# ------------------------------------------------------------------------------
# 6. Security, Authentication & Session Tokens (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_access_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Two-Factor Authentication (2FA / TOTP)
TWO_FACTOR_APP_NAME="BugTracker"

# Initial System Administrator Seed
INITIAL_ADMIN_EMAIL=admin@bugtracker.local
INITIAL_ADMIN_PASSWORD=AdminPassword123!
INITIAL_ADMIN_NAME="System Administrator"

# ------------------------------------------------------------------------------
# 7. External Identity Providers (OAuth2 / OIDC)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=placeholder_github_client_id
GITHUB_CLIENT_SECRET=placeholder_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 8. Bot Protection (Cloudflare Turnstile CAPTCHA)
# ------------------------------------------------------------------------------
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=placeholder_turnstile_secret_key
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
VITE_TURNSTILE_SITE_KEY=placeholder_turnstile_site_key
