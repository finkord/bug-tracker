# ==============================================================================
# BugTracker Production Environment Configuration (.env.prod)
# ==============================================================================
# Copy this file to .env.prod and customize values for your deployment.
# Usage:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# ==============================================================================

# Application Exposure
HTTP_PORT=80
FRONTEND_URL=http://localhost
CORS_ORIGIN=http://localhost

# Database (PostgreSQL 15)
DB_USER=postgres
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=bug_tracker
DB_SYNCHRONIZE=true

# Cache & Message Broker (Redis 7)
REDIS_PASSWORD=

# Security & Tokens (Generate 32+ character random strings)
JWT_SECRET=replace_with_random_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=replace_with_another_random_secret_minimum_32_characters_long

# Initial System Administrator Account (Used on first system initialization)
INITIAL_ADMIN_EMAIL=admin@company.com
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
INITIAL_ADMIN_NAME="System Administrator"

# Customer Outgoing SMTP Mail Server (Required for user invitations and notifications)
MAIL_HOST=smtp.company.com
MAIL_PORT=587
MAIL_USER=no-reply@company.com
MAIL_PASSWORD=your_smtp_password
MAIL_SECURE=false
MAIL_FROM="BugTracker <no-reply@company.com>"

# Object Storage / SeaweedFS (Defaults to embedded SeaweedFS service)
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=any
S3_SECRET_ACCESS_KEY=any
S3_BUCKET_NAME=bugtracker-attachments
S3_FORCE_PATH_STYLE=true

# Optional: API Documentation (Swagger) - Recommended false in production
ENABLE_SWAGGER=false
