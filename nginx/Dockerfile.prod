# ==============================================================================
# BugTracker Production Web Tier (Nginx Ingress + Pre-compiled React SPA)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build React 19 Frontend SPA Bundle
# ------------------------------------------------------------------------------
FROM node:24-slim AS frontend-builder

WORKDIR /app

# Set production API and WebSocket endpoints (relative routes proxied by Nginx)
ARG VITE_API_URL=/api/v1
ARG VITE_SOCKET_URL=/events
ARG VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFBDW7LqZnzsV119

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_SOCKET_URL=${VITE_SOCKET_URL}
ENV VITE_TURNSTILE_SITE_KEY=${VITE_TURNSTILE_SITE_KEY}

# Install dependencies
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps

# Copy frontend source and build optimized distribution
COPY frontend/ ./
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Minimal Hardened Nginx Ingress & Static Server
# ------------------------------------------------------------------------------
FROM nginx:alpine AS runner

# Clear default Nginx configuration files
RUN rm -rf /etc/nginx/conf.d/*

# Deploy tuned Nginx configuration and production virtual host
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/prod.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from frontend build stage
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

EXPOSE 80

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
